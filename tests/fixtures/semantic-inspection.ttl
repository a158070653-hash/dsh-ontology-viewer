@prefix ex: <urn:semantic-inspection:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Small deterministic manual/automated inspection fixture: all facts are explicit.
ex:A a owl:Class ; rdfs:label "A" ; rdfs:subClassOf ex:B .
ex:B a owl:Class ; rdfs:label "B" ; rdfs:subClassOf ex:A .
ex:p a owl:ObjectProperty ; rdfs:domain ex:A ; rdfs:range ex:B .
ex:Restriction a owl:Restriction ; owl:onProperty ex:p ; owl:someValuesFrom ex:B .
ex:Broken a owl:Class ; owl:unionOf _:incomplete .
_:incomplete rdf:first ex:A .
