<?xml version="1.0" encoding="UTF-8"?>
<!-- RDF/XML 示例：一个图书馆借阅模型。 -->
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:lib="http://example.org/library#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns="http://example.org/library#"
    xml:base="http://example.org/library#">

  <rdfs:Class rdf:about="Book">
    <rdfs:label xml:lang="en">Book</rdfs:label>
    <rdfs:label xml:lang="zh">图书</rdfs:label>
    <rdfs:comment>A physical or digital book.</rdfs:comment>
  </rdfs:Class>

  <rdfs:Class rdf:about="Member">
    <rdfs:label xml:lang="en">Member</rdfs:label>
    <rdfs:label xml:lang="zh">读者</rdfs:label>
  </rdfs:Class>

  <rdfs:Class rdf:about="Loan">
    <rdfs:label xml:lang="en">Loan</rdfs:label>
    <rdfs:label xml:lang="zh">借阅</rdfs:label>
  </rdfs:Class>

  <rdf:Property rdf:about="title">
    <rdfs:domain rdf:resource="Book"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:label xml:lang="en">title</rdfs:label>
  </rdf:Property>

  <rdf:Property rdf:about="borrowedBy">
    <rdfs:domain rdf:resource="Loan"/>
    <rdfs:range rdf:resource="Member"/>
    <rdfs:label xml:lang="en">borrowed by</rdfs:label>
    <rdfs:label xml:lang="zh">借阅人</rdfs:label>
  </rdf:Property>

  <rdf:Description rdf:about="Book-001">
    <rdf:type rdf:resource="Book"/>
    <title xml:lang="en">Designing Data-Intensive Applications</title>
    <lib:isbn rdf:datatype="http://www.w3.org/2001/XMLSchema#string">978-1449373320</lib:isbn>
    <lib:pages rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">616</lib:pages>
  </rdf:Description>

  <rdf:Description rdf:about="Member-alice">
    <rdf:type rdf:resource="Member"/>
    <lib:name>Alice</lib:name>
    <lib:joined rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-05-01</lib:joined>
  </rdf:Description>

  <lib:Loan rdf:about="Loan-42">
    <lib:borrowedBy rdf:resource="Member-alice"/>
    <lib:loanOf rdf:resource="Book-001"/>
    <lib:dueOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-20</lib:dueOn>
  </lib:Loan>

</rdf:RDF>
