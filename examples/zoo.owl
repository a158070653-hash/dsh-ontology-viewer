<?xml version="1.0"?>
<!-- OWL 本体示例：动物分类与限制（含空白节点 owl:Restriction）。 -->
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:zoo="http://example.org/zoo#"
    xmlns="http://example.org/zoo#"
    xml:base="http://example.org/zoo#">

  <owl:Ontology rdf:about="">
    <rdfs:label xml:lang="en">Zoo Ontology</rdfs:label>
    <rdfs:label xml:lang="zh">动物园本体</rdfs:label>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </owl:Ontology>

  <owl:Class rdf:about="Animal">
    <rdfs:label xml:lang="en">Animal</rdfs:label>
    <rdfs:label xml:lang="zh">动物</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="Mammal">
    <rdfs:subClassOf rdf:resource="Animal"/>
    <rdfs:label xml:lang="en">Mammal</rdfs:label>
    <rdfs:label xml:lang="zh">哺乳动物</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="Bird">
    <rdfs:subClassOf rdf:resource="Animal"/>
    <rdfs:label xml:lang="en">Bird</rdfs:label>
    <rdfs:label xml:lang="zh">鸟类</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="Elephant">
    <rdfs:subClassOf rdf:resource="Mammal"/>
    <rdfs:label xml:lang="en">Elephant</rdfs:label>
    <rdfs:label xml:lang="zh">大象</rdfs:label>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="hasHabitat"/>
        <owl:someValuesFrom rdf:resource="Savanna"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <owl:Class rdf:about="Penguin">
    <rdfs:subClassOf rdf:resource="Bird"/>
    <rdfs:label xml:lang="en">Penguin</rdfs:label>
    <rdfs:label xml:lang="zh">企鹅</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="Habitat">
    <rdfs:label xml:lang="en">Habitat</rdfs:label>
    <rdfs:label xml:lang="zh">栖息地</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="Savanna">
    <rdfs:subClassOf rdf:resource="Habitat"/>
    <rdfs:label xml:lang="en">Savanna</rdfs:label>
    <rdfs:label xml:lang="zh">稀树草原</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="Antarctica">
    <rdfs:subClassOf rdf:resource="Habitat"/>
    <rdfs:label xml:lang="en">Antarctica</rdfs:label>
    <rdfs:label xml:lang="zh">南极</rdfs:label>
  </owl:Class>

  <owl:ObjectProperty rdf:about="hasHabitat">
    <rdfs:domain rdf:resource="Animal"/>
    <rdfs:range rdf:resource="Habitat"/>
    <rdfs:label xml:lang="en">has habitat</rdfs:label>
    <rdfs:label xml:lang="zh">栖息于</rdfs:label>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="weightKg">
    <rdfs:domain rdf:resource="Animal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">weight (kg)</rdfs:label>
    <rdfs:label xml:lang="zh">体重（kg）</rdfs:label>
  </owl:DatatypeProperty>

  <owl:NamedIndividual rdf:about="dumbo">
    <rdf:type rdf:resource="Elephant"/>
    <rdfs:label xml:lang="en">Dumbo</rdfs:label>
    <zoo:name>Dumbo</zoo:name>
    <weightKg rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5400.5</weightKg>
    <hasHabitat rdf:resource="Savanna"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="pingu">
    <rdf:type rdf:resource="Penguin"/>
    <rdfs:label xml:lang="en">Pingu</rdfs:label>
    <weightKg rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">31.2</weightKg>
    <hasHabitat rdf:resource="Antarctica"/>
  </owl:NamedIndividual>

</rdf:RDF>
